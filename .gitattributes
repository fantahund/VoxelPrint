# Normalise line endings in the repository to LF.
* text=auto eol=lf

# The Gradle wrapper script is executed by sh. CRLF breaks it on Linux and macOS.
gradlew text eol=lf

# The Windows wrapper is executed by cmd and wants CRLF.
gradlew.bat text eol=crlf

# Never touch binaries.
*.jar binary
*.png binary
*.ogg binary
*.mcprint binary
*.schem binary
